{
  "name": "scoop-native",
  "private": true,
  "version": "1.0.0",
  "description": "Enveloppe iOS et Android de Scoop (Capacitor)",
  "scripts": {
    "www": "mkdir -p www && echo '<!doctype html><meta charset=utf-8><title>Scoop</title><p>Chargement…' > www/index.html",
    "add:android": "npx cap add android",
    "add:ios": "npx cap add ios",
    "sync": "npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0"
  },
  "devDependencies": { "@capacitor/cli": "^6.0.0" }
}
